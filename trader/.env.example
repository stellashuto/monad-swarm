# ============================================
#  Trader Agent — Environment Configuration
#  自律分散型ベンチャーDAO (The Executor)
# ============================================
ROLE="TRADER"

# Traderはコストと速度重視のためHaiku 4.5を使用
MODEL_NAME="claude-haiku-4-5-20251001"

# Anthropic API Key (必須 — 自分のキーに置き換えてください)
ANTHROPIC_API_KEY="CHANGE_ME"

# Trader Wallet Private Key (0x prefix付き)
PRIVATE_KEY="CHANGE_ME"

# Manager Wallet Address (利益返金先 / 入金元フィルタ)
BOSS_WALLET_ADDRESS="0xYOUR_MANAGER_WALLET_ADDRESS"

# Monad RPC Endpoint
MONAD_RPC_URL="https://rpc.monad.xyz"
CHAIN_ID=1014

# DEX Router Address (Uniswap V2互換 — 実際のアドレスに置き換え)
DEX_ROUTER_ADDRESS="0xCaC3F5268045657064344BCa22A3097C23377777"

# --- Cost Control (The Gatekeeper) ---
# ブロックポーリング間隔 (秒)
POLL_INTERVAL_SECONDS=10
# 1日あたりの最大API呼び出し回数
MAX_DAILY_API_CALLS=300
# スリッページ許容 (basis points: 300 = 3%)
SLIPPAGE_BPS=300
# 損切りライン (%)
STOP_LOSS_PCT=15
# Manager還元率 (% — Traderの取り分は100-この値)
PROFIT_SHARE_PCT=80
