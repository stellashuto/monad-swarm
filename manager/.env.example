# ============================================
#  Manager Agent — Environment Configuration
#  自律分散型ベンチャーDAO (The Venture Protocol)
# ============================================
ROLE="MANAGER"

# Managerは高度な判断を行うため最新のSonnet 4.5を使用
MODEL_NAME="claude-sonnet-4-5-20250929"

# Anthropic API Key (必須 — 自分のキーに置き換えてください)
ANTHROPIC_API_KEY="CHANGE_ME"

# Manager Wallet Private Key (0x prefix付き)
PRIVATE_KEY="CHANGE_ME"

# Trader Wallet Address (送金先)
TARGET_TRADER_ADDRESS="0xYOUR_TRADER_WALLET_ADDRESS"

# GMGN API URL (トレンドデータ取得用)
GMGN_API_URL="https://gmgn.ai/defi/quotation/v1/rank/monad/swaps/1h"

# Monad RPC Endpoint
MONAD_RPC_URL="https://rpc.monad.xyz"
CHAIN_ID=1014

# --- Cost Control (The Gatekeeper) ---
# トレンドポーリング間隔 (秒)
POLL_INTERVAL_SECONDS=60
# 1日あたりの最大API呼び出し回数
MAX_DAILY_API_CALLS=200
# 1回の送金上限 (MON)
MAX_FUND_AMOUNT_MON=0.5
